<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="XE_Local_AI_Engine.Tray.App">
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/tray-red.ico" ToolTipText="XE Local AI Engine - HostAgent unreachable">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open Web UI" IsEnabled="False" Click="OpenWebUiMenuItemOnClick" />
                        <NativeMenuItem Header="Start HostAgent" IsVisible="True" Click="StartHostAgentMenuItemOnClick" />
                        <NativeMenuItem Header="Stop Services" IsVisible="False" Click="StopServicesMenuItemOnClick" />
                        <NativeMenuItem Header="Start Services" IsVisible="False" Click="StartServicesMenuItemOnClick" />
                        <NativeMenuItem Header="Restart Runtime" IsVisible="False" Click="RestartRuntimeMenuItemOnClick" />
                        <NativeMenuItem Header="Show Diagnostics" IsEnabled="False" Click="ShowDiagnosticsMenuItemOnClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Quit Tray" Click="QuitTrayMenuItemOnClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
