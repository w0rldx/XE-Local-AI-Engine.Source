<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>XE_Local_AI_Engine.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI"/>
    <PackageReference Include="Azure.Identity"/>
    <PackageReference Include="BouncyCastle.Cryptography"/>
    <PackageReference Include="CommunityToolkit.Aspire.OllamaSharp"/>
    <!-- Development Mode container sandbox (ADR 0004). See Directory.Packages.props for why the id is the `.Enhanced`
         fork rather than the 2023-era original. -->
    <PackageReference Include="Docker.DotNet.Enhanced"/>
    <PackageReference Include="DocumentFormat.OpenXml"/>
    <!-- Direct, not transitive-through-AI.Agent: this project calls AgentSkillFrontmatter.ValidateName/ValidateDescription
         as the authority for skill validation (AgentSkillService, AgentDefinitionResolver) and constructs
         AgentSkillsProvider in SubAgentSpawnService. A validation authority must not ride a transitive flow that a
         future ProjectReference prune would silently remove. Version comes from CPM, so this adds no version surface. -->
    <PackageReference Include="Microsoft.Agents.AI"/>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore"/>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"/>
    <PackageReference Include="Microsoft.Extensions.AI"/>
    <!-- Microsoft.Extensions.AI.OpenAI brings the OpenAI SDK in transitively (pinned via CentralPackageTransitivePinningEnabled,
         same as Providers.CodexOAuth): the plain OpenAI.OpenAIClient used by AzureFoundryChatClientFactory's v1 API
         surface needs no direct PackageReference of its own. -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI"/>
    <PackageReference Include="Microsoft.Extensions.DataIngestion.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience"/>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens"/>
    <!-- MSAL confidential-client for the Entra ID authorization-code sign-in flow (see Directory.Packages.props). -->
    <PackageReference Include="Microsoft.Identity.Client"/>
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal"/>
    <PackageReference Include="ModelContextProtocol"/>
    <PackageReference Include="NSec.Cryptography"/>
    <PackageReference Include="OllamaSharp"/>
    <PackageReference Include="Quartz"/>
    <PackageReference Include="Quartz.Extensions.Hosting"/>
    <PackageReference Include="Quartz.Plugins"/>
    <PackageReference Include="Quartz.Plugins.TimeZoneConverter"/>
    <PackageReference Include="Quartz.Serialization.SystemTextJson"/>
    <PackageReference Include="Serilog"/>
    <PackageReference Include="System.Numerics.Tensors"/>
    <PackageReference Include="PdfPig"/>
    <PackageReference Include="UTF.Unknown"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Curated starter-pack templates, transformed once at build time from the vendored agency-agents source. The
         catalog loads this by manifest-resource-name suffix at runtime, so no network egress occurs. -->
    <EmbeddedResource Include="Services\Agents\Templates\agent-templates.seed.json"/>
    <!-- Bundled model-recommendation catalog (schema v1) — every ggufRepo id is live-verified against the Hugging
         Face API before being added. Loaded by manifest-resource-name suffix; the provider optionally replaces this
         in-memory with a remote refresh, but the app always has a working catalog with zero configuration. -->
    <EmbeddedResource Include="Services\ModelFit\Catalog\model-catalog.seed.json"/>
    <!-- Bundled image-model catalog (schema v1). Every repo id, file name and per-file byte size was verified against
         the live Hugging Face API before being added: a one-click install that 404s, or one whose declared size is
         wrong, is worse than an absent row (the size drives the free-disk pre-flight AND the aggregate progress). -->
    <EmbeddedResource Include="Services\Images\Catalog\image-model-catalog.seed.json"/>
    <!-- Docker's own default seccomp profile, copied verbatim from the module the daemon itself vendors
         (moby/profiles, tag seccomp/v0.2.3). Embedded rather than materialized to disk: the Engine API takes profile
         CONTENT, not a host path, so a file on disk is not something the daemon would ever open. See
         DockerSeccompProfile for the provenance and the measured evidence. -->
    <EmbeddedResource Include="Services\Sandbox\Container\seccomp-default.json"/>
    <!-- The two halves of the pythonTests execution harness. Embedded rather than kept as C# string literals because
         they are the reviewed statement of a security boundary and have to read as Python; and rather than shipped as
         files because nothing about pythonTests writes to disk on either side: the parent goes to the sandbox on
         stdin and the child goes to a pipe the parent owns. Loaded by manifest-resource-name suffix. -->
    <EmbeddedResource Include="Services\Benchmarks\PythonTests\xe-pythontests-parent.py"/>
    <EmbeddedResource Include="Services\Benchmarks\PythonTests\xe-pythontests-child.py"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XE-Local-AI-Engine.AI.Agent\XE-Local-AI-Engine.AI.Agent.csproj"/>
    <ProjectReference Include="..\XE-Local-AI-Engine.Client.Persistence\XE-Local-AI-Engine.Client.Persistence.csproj"/>
    <ProjectReference Include="..\XE-Local-AI-Engine.Providers.Abstractions\XE-Local-AI-Engine.Providers.Abstractions.csproj"/>
    <ProjectReference Include="..\XE-Local-AI-Engine.Providers.Capabilities\XE-Local-AI-Engine.Providers.Capabilities.csproj"/>
    <ProjectReference Include="..\XE-Local-AI-Engine.Providers.CodexOAuth\XE-Local-AI-Engine.Providers.CodexOAuth.csproj"/>
    <ProjectReference Include="..\XE-Local-AI-Engine.Providers.HuggingFace\XE-Local-AI-Engine.Providers.HuggingFace.csproj"/>
    <ProjectReference Include="..\XE-Local-AI-Engine.Providers.LlamaServer\XE-Local-AI-Engine.Providers.LlamaServer.csproj"/>
    <ProjectReference Include="..\XE-Local-AI-Engine.Providers.Ollama\XE-Local-AI-Engine.Providers.Ollama.csproj"/>
    <ProjectReference Include="..\XE-Local-AI-Engine.Providers.OpenAICompat\XE-Local-AI-Engine.Providers.OpenAICompat.csproj"/>
    <ProjectReference Include="..\XE-Local-AI-Engine.Providers.StableDiffusionCpp\XE-Local-AI-Engine.Providers.StableDiffusionCpp.csproj"/>
    <ProjectReference Include="..\XE-Local-AI-Engine.Providers.Training\XE-Local-AI-Engine.Providers.Training.csproj"/>
    <ProjectReference Include="..\XE-Local-AI-Engine.ServiceDefaults\XE-Local-AI-Engine.ServiceDefaults.csproj"/>
    <ProjectReference Include="..\XE-Local-AI-Engine.AI.Contracts\XE-Local-AI-Engine.AI.Contracts.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- The training export runs its pipeline on a detached background task; tests await the same handle the service
         holds rather than racing a store substitute for a side effect that may not have landed yet. -->
    <InternalsVisibleTo Include="XE-Local-AI-Engine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="XE_Local_AI_Engine.AI.Contracts.Enums"/>
    <Using Include="XE_Local_AI_Engine.AI.Contracts.Events"/>
    <Using Include="Microsoft.Extensions.Configuration"/>
    <Using Include="Microsoft.Extensions.DependencyInjection"/>
    <Using Include="Microsoft.Extensions.Hosting"/>
    <Using Include="Microsoft.Extensions.Logging"/>
    <Using Include="System.Net.Http.Json"/>
  </ItemGroup>

</Project>
