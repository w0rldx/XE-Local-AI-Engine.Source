{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information"
    }
  },
  "Ollama": {
    "Endpoint": "http://127.0.0.1:11434"
  },
  "Agent": {
    "LocalChat": {
      "AgentName": "XeLocalAgent",
      "DefaultModel": "qwen3.5:0.8b",
      "InstructionsResource": "XE_Local_AI_Engine.AI.Agent.Instructions.LocalChatDefault.txt",
      "EnableTools": true
    },
    "Invocation": {
      "AgentNamePrefix": "XeInvocation"
    }
  },
  "CentralPlatform": {
    "BaseUrl": "https://localhost:7003",
    "HubPath": "/hub/worker",
    "PairingEndpoint": "/api/v1/client-nodes/pair",
    "HeartbeatIntervalSeconds": 30,
    "ReconnectBackoffBaseMs": 1000,
    "ReconnectBackoffMaxMs": 30000,
    "ReconnectBackoffJitterMs": 500,
    "ReconnectMaxAttempts": 0,
    "MaxSignalRMessageSizeKb": 128,
    "ToolCallTimeoutSeconds": 30,
    "InvocationTimeoutSeconds": 300
  },
  "WorkerNode": {
    "NodeName": "XE-Local-Worker-01",
    "MaxResponseSizeMb": 10,
    "DeadLetterQueuePath": "dead-letter-queue",
    "MaxPendingToolCallAgeMinutes": 5,
    "CleanupIntervalSeconds": 60
  },
  "Security": {
    "MaxSystemPromptSizeKb": 100,
    "MaxMessageSizeKb": 50,
    "AllowedModelNamePattern": "^[a-zA-Z0-9._:-]+$"
  },
  "AllowedHosts": "*"
}
