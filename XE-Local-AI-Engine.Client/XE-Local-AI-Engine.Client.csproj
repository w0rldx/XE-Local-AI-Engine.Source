<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>31bd0c1c-d903-4e54-bae9-df0140eb36bd</UserSecretsId>
    <RootNamespace>XE_Local_AI_Engine.Client</RootNamespace>
    <!--
      Disable the SDK StaticWebAssets pipeline for this host. After the /app→root cutover the React
      shell lives at wwwroot\index.html (BasePath "/"), which collides with the
      Microsoft.Agents.AI.DevUI package's own staticwebassets\index.html (also BasePath "/") — the SDK
      fails with "Conflicting assets with the same target path 'index.html'" (and, in the dev manifest
      path, "Sequence contains more than one element") on rebuilds. The host serves the React shell +
      assets via app.UseStaticFiles() + MapFallbackToFile("index.html") (physical wwwroot files), NOT via the
      StaticWebAssets manifest, and Blazor endpoints are removed at cutover, so nothing depends
      on the SWA pipeline here. With it off there is no manifest to collide, which also makes the
      wwwroot copy idempotent across rebuilds. wwwroot content still publishes via the default
      <Content Include="wwwroot\**"> (CopyToPublishDirectory) for UseStaticFiles.
    -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <NodeReactClientDir>$(MSBuildProjectDirectory)\..\XE-Local-AI-Engine.Client.React\</NodeReactClientDir>
    <NodeReactBuildDir>$(NodeReactClientDir)dist\</NodeReactBuildDir>
    <!-- The React build is copied to the wwwroot root (Vite base "/"),
         not the transition wwwroot\app\ sub-directory. -->
    <NodeReactWebRootDir>$(MSBuildProjectDirectory)\wwwroot\</NodeReactWebRootDir>
  </PropertyGroup>

  <!--
    node-settings.json is RUNTIME state: NodeSettingsStore writes it to ContentRootPath at runtime (e.g. the selected
    default model). The Web SDK's default content globbing would otherwise pick up a dev-created copy and PUBLISH it,
    shipping a stale "defaultModelName" into the bundle — which makes first-run model provisioning think a model is
    already selected and skip the GGUF download (empty model store). Exclude it from content/publish so it can never
    ship; a fresh install must start with no settings file. (It is also .gitignored.)
  -->
  <ItemGroup>
    <Content Remove="node-settings.json"/>
    <None Remove="node-settings.json"/>
  </ItemGroup>

  <!--
    The runtime-written per-node directories, removed from EVERY default glob including Compile.

    node-settings.json above covers one file against one glob. These directories need the wider treatment because
    Development Mode clones REGISTERED REPOSITORIES into `development/workspaces/`, and in a source checkout
    INodeDataDirectory resolves to ContentRootPath — this directory. The Web SDK then globs the cloned repository's
    own source into this project.

    Measured on 2026-07-31, after three Development Mode tasks against a small C# repository, `dotnet build` of this
    project failed with CS0101/CS0579 duplicate-definition errors from `development/workspaces/**/Calculator.cs` and
    from the workspaces' own obj/ trees. The host application stopped compiling because an agent wrote a file in a
    sandbox.

    The build break is the loud half. The quiet half is worse and is why this is a Compile exclusion and not just a
    Content one: without it, C# written by a model into an untrusted repository's workspace is a source file of this
    application, compiled into its assembly on publish.

    Keep this list in step with .gitignore's entries for the same paths — they exist for the same reason, and "gitignored"
    and "not globbed" are different guarantees.
  -->
  <ItemGroup>
    <Compile Remove="development/**;generated-images/**;logs/**;backups/**;dp-keys/**;models/**"/>
    <Content Remove="development/**;generated-images/**;logs/**;backups/**;dp-keys/**;models/**"/>
    <None Remove="development/**;generated-images/**;logs/**;backups/**;dp-keys/**;models/**"/>
    <EmbeddedResource Remove="development/**;generated-images/**;logs/**;backups/**;dp-keys/**;models/**"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI"/>
    <PackageReference Include="BouncyCastle.Cryptography"/>
    <PackageReference Include="CommunityToolkit.Aspire.OllamaSharp"/>
    <PackageReference Include="FastEndpoints"/>
    <PackageReference Include="FastEndpoints.Swagger"/>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"/>
    <PackageReference Include="ModelContextProtocol.AspNetCore"/>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client"/>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens"/>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience"/>
    <PackageReference Include="Microsoft.Extensions.AI"/>
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI"/>
    <!-- Debug-only: DevUI dashboard dependencies only ship as preview/alpha packages; the Release
         (published desktop) build compiles the DevUI wiring out (#if DEBUG in Program.cs) and must
         not carry these assemblies. -->
    <PackageReference Include="Microsoft.Agents.AI.Hosting.OpenAI" Condition="'$(Configuration)' == 'Debug'"/>
    <PackageReference Include="Microsoft.Agents.AI.DevUI" Condition="'$(Configuration)' == 'Debug'"/>
    <PackageReference Include="NSec.Cryptography"/>
    <PackageReference Include="OllamaSharp"/>
    <PackageReference Include="Scalar.AspNetCore"/>
    <PackageReference Include="System.Security.Cryptography.ProtectedData"/>
    <PackageReference Include="Serilog"/>
    <PackageReference Include="Serilog.AspNetCore"/>
    <PackageReference Include="Serilog.Enrichers.Environment"/>
    <PackageReference Include="Serilog.Enrichers.Process"/>
    <PackageReference Include="Serilog.Enrichers.Thread"/>
    <PackageReference Include="Serilog.Expressions"/>
    <PackageReference Include="Serilog.Settings.Configuration"/>
    <PackageReference Include="Serilog.Sinks.Console"/>
    <PackageReference Include="Serilog.Sinks.File"/>
    <PackageReference Include="Velopack"/>
  </ItemGroup>

  <!--
    App self-update build flavor (decision #12). UpdateChannel selects, at publish time, the baked-in update repo URL +
    GitHub App client_id consumed by AppUpdateChannelOptions. Both values are PUBLIC config (the device-flow client_id
    needs no client secret; the repo URL is public) — not secrets, safe to bake into the artifact. There is no runtime
    switch: a tester build can never point at the main repo and vice-versa. The active flavor's
    appsettings.AppUpdate.{flavor}.json is copied to the output as appsettings.AppUpdate.json so the host loads exactly
    one channel file regardless of UpdateChannel. Default flavor is main.
  -->
  <PropertyGroup>
    <UpdateChannel Condition="'$(UpdateChannel)' == ''">main</UpdateChannel>
  </PropertyGroup>

  <Target Name="ValidateAppUpdateChannel"
          BeforeTargets="PrepareForBuild;ComputeFilesToPublish">
    <Error Condition="'$(UpdateChannel)' != 'main' and '$(UpdateChannel)' != 'tester'"
           Text="Unsupported UpdateChannel '$(UpdateChannel)'. Expected 'main' or 'tester'."/>
    <Error Condition="!Exists('appsettings.AppUpdate.$(UpdateChannel).json')"
           Text="App-update configuration not found: appsettings.AppUpdate.$(UpdateChannel).json"/>
  </Target>

  <ItemGroup>
    <!-- The product is proprietary and the artifact must carry its terms. Both packaging paths
         (the Velopack pack step and publish/package-rc.sh) stage from this publish directory,
         so shipping them here covers every channel. Output stays clean for dev/test runs. -->
    <Content Include="$(MSBuildProjectDirectory)/../LICENSE"
             Link="LICENSE"
             CopyToPublishDirectory="PreserveNewest"
             CopyToOutputDirectory="Never"/>
    <Content Include="$(MSBuildProjectDirectory)/../NOTICE"
             Link="NOTICE"
             CopyToPublishDirectory="PreserveNewest"
             CopyToOutputDirectory="Never"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Keep both flavor sources out of default content globbing so only the active one ships (renamed) below. -->
    <Content Remove="appsettings.AppUpdate.main.json"/>
    <Content Remove="appsettings.AppUpdate.tester.json"/>
    <None Include="appsettings.AppUpdate.main.json"/>
    <None Include="appsettings.AppUpdate.tester.json"/>
    <!--
      Only the active flavor's source is copied to output (renamed), so the artifact carries exactly one channel.

      Always, NOT PreserveNewest, and that is load-bearing. publish/package-tester-win.ps1 injects the GitHub App
      client ID by rewriting the COPY in the publish directory, which leaves the destination permanently newer than
      its source. Under PreserveNewest the next publish then skipped the copy altogether and a previous run's baked
      client ID survived into the new artifact — measured on Windows 11 2026-08-02, where it blocked a -SkipUpload
      rehearsal build whose guard correctly refused a package carrying a stale Iv23… ID. The same mechanism could
      carry a tester config into a main-channel build, which would break the invariant stated above that a tester
      build can never point at the main repo. Always makes every publish overwrite the destination regardless of
      timestamps, so the artifact's channel config is always the one this build selected.
    -->
    <Content Include="appsettings.AppUpdate.$(UpdateChannel).json"
             Condition="Exists('appsettings.AppUpdate.$(UpdateChannel).json')"
             Link="appsettings.AppUpdate.json"
             CopyToOutputDirectory="Always"
             CopyToPublishDirectory="Always"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Development-only config must never ship in release/publish artifacts.
         The Web SDK auto-publishes appsettings.{Environment}.json; remove it explicitly. -->
    <Content Remove="appsettings.Development.json"/>
    <None Include="appsettings.Development.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XE-Local-AI-Engine.AI.Agent\XE-Local-AI-Engine.AI.Agent.csproj"/>
    <ProjectReference Include="..\XE-Local-AI-Engine.Client.Application\XE-Local-AI-Engine.Client.Application.csproj"/>
    <ProjectReference Include="..\XE-Local-AI-Engine.Client.Persistence\XE-Local-AI-Engine.Client.Persistence.csproj"/>
    <ProjectReference Include="..\XE-Local-AI-Engine.Providers.Abstractions\XE-Local-AI-Engine.Providers.Abstractions.csproj"/>
    <ProjectReference Include="..\XE-Local-AI-Engine.Providers.Ollama\XE-Local-AI-Engine.Providers.Ollama.csproj"/>
    <ProjectReference Include="..\XE-Local-AI-Engine.ServiceDefaults\XE-Local-AI-Engine.ServiceDefaults.csproj"/>
    <ProjectReference Include="..\XE-Local-AI-Engine.AI.Contracts\XE-Local-AI-Engine.AI.Contracts.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="XE_Local_AI_Engine.AI.Contracts.Enums"/>
    <Using Include="XE_Local_AI_Engine.AI.Contracts.Events"/>
  </ItemGroup>

  <!--
    Copy the node React build (dist) into wwwroot root for the host to serve via UseStaticFiles +
    MapFallbackToFile("index.html"). The target deletes the previously copied React outputs (root files +
    assets/) before re-copying so it is hygienic across rebuilds. Idempotency across consecutive
    rebuilds is provided by removing these outputs from SDK static-web-asset discovery (the
    Content Remove / None Include block above) so a populated wwwroot does not produce a duplicate
    or conflicting logical asset for /index.html on the second build.
    Only the React build outputs are removed; the tracked wwwroot\.gitignore is preserved.
  -->
  <Target Name="CopyNodeReactBuildToWwwroot"
          BeforeTargets="Build;ComputeFilesToPublish"
          Condition="Exists('$(NodeReactBuildDir)index.html')">
    <ItemGroup>
      <NodeReactBuildFiles Include="$(NodeReactBuildDir)**\*.*"/>
      <NodeReactStaleRootFiles Include="$(NodeReactWebRootDir)index.html"/>
      <NodeReactStaleRootFiles Include="$(NodeReactWebRootDir)favicon.png"/>
      <NodeReactStaleRootFiles Include="$(NodeReactWebRootDir)logo.png"/>
      <NodeReactStaleRootFiles Include="$(NodeReactWebRootDir)logo192.png"/>
      <NodeReactStaleRootFiles Include="$(NodeReactWebRootDir)logo512.png"/>
      <NodeReactStaleRootFiles Include="$(NodeReactWebRootDir)manifest.json"/>
      <NodeReactStaleRootFiles Include="$(NodeReactWebRootDir)robots.txt"/>
      <NodeReactStaleRootFiles Include="$(NodeReactWebRootDir)staticwebapp.config.json"/>
      <NodeReactStaleRootFiles Include="$(NodeReactWebRootDir)web.config"/>
      <NodeReactStaleRootFiles Include="$(NodeReactWebRootDir)app.css"/>
      <NodeReactStaleRootFiles Include="$(NodeReactWebRootDir)xen_logo_mark.svg"/>
      <NodeReactStaleRootFiles Include="$(NodeReactWebRootDir)xen_logo_wordmark.svg"/>
    </ItemGroup>

    <MakeDir Directories="$(NodeReactWebRootDir)"/>
    <RemoveDir Directories="$(NodeReactWebRootDir)assets"/>
    <!-- Remove the transition-era wwwroot\app\ tree so stale prefixed assets/shell are not served after cutover. -->
    <RemoveDir Directories="$(NodeReactWebRootDir)app"/>
    <Delete Files="@(NodeReactStaleRootFiles)"/>
    <Copy SourceFiles="@(NodeReactBuildFiles)"
          DestinationFiles="@(NodeReactBuildFiles->'$(NodeReactWebRootDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"/>
    <Message Importance="high" Text="Copied node React build from $(NodeReactBuildDir) to $(NodeReactWebRootDir)."/>
  </Target>

  <!--
    Fail a publish loudly when the React SPA has not been built. wwwroot\** is gitignored (only .gitignore is
    tracked), so a fresh checkout has an empty wwwroot, and CopyNodeReactBuildToWwwroot above only runs when
    dist\index.html exists. Without this guard a publish whose React build was skipped ships an empty wwwroot and
    the host serves 404 for index.html (a blank app) with no build-time signal — exactly how a packaged build can
    look "started" yet render nothing. Publish-only (BeforeTargets=ComputeFilesToPublish, same phase as the copy
    above): dotnet build / CI / unit tests never run this, so they are unaffected and need no pnpm build.
  -->
  <Target Name="GuardNodeReactBuildPresentOnPublish"
          BeforeTargets="ComputeFilesToPublish"
          Condition="!Exists('$(NodeReactBuildDir)index.html')">
    <Error Text="React SPA build not found at $(NodeReactBuildDir)index.html. Run 'pnpm build' in XE-Local-AI-Engine.Client.React before publishing — otherwise the host ships an empty wwwroot and serves 404 for index.html (a blank app)." />
  </Target>

</Project>
