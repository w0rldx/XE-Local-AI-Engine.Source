{
  "Development": {
    "Enabled": true
  },
  "Agent": {
    "LocalChat": {
      "AgentName": "XeLocalAgent",
      "InstructionsResource": "XE_Local_AI_Engine.AI.Agent.Instructions.LocalChatDefault.txt",
      "EnableTools": true,
      "MaxInlinedAttachmentChars": 48000
    },
    "Invocation": {
      "AgentNamePrefix": "XeInvocation"
    },
    "Orchestration": {
      "IdleTimeoutSeconds": 120
    }
  },
  "CentralPlatform": {
    "BaseUrl": "https://localhost:7003",
    "HubPath": "/hub/worker",
    "PairingEndpoint": "/api/v1/client-nodes/pair",
    "HeartbeatIntervalSeconds": 30,
    "ReconnectBackoffBaseMs": 1000,
    "ReconnectBackoffMaxMs": 1800000,
    "ReconnectBackoffJitterMs": 500,
    "ReconnectMaxAttempts": 0
  },
  "AgentHome": {
    "Enabled": true,
    "Sandbox": {
      "Provider": "process"
    },
    "ToolCapableModels": [
      "qwen3:8b",
      "bartowski/Qwen2.5-3B-Instruct-GGUF:Q4_K_M"
    ]
  },
  "WorkerNode": {
    "NodeName": "XE-Local-Worker-01",
    "MaxResponseSizeMb": 10,
    "DeadLetterQueuePath": "dead-letter-queue",
    "MaxPendingToolCallAgeMinutes": 10,
    "CleanupIntervalSeconds": 60
  },
  "Security": {
    "MaxSystemPromptSizeKb": 100,
    "MaxMessageSizeKb": 256,
    "MaxUploadFileSizeMb": 25,
    "AllowedModelNamePattern": "^(?:[a-zA-Z0-9._:-]+|(?:(?:hf\\.co|huggingface\\.co)/)?[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+(?::[a-zA-Z0-9._-]+)?)$"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Expressions"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning",
        "Microsoft.AspNetCore.Http.Connections": "Warning",
        "Microsoft.AspNetCore.SignalR": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  }
}
