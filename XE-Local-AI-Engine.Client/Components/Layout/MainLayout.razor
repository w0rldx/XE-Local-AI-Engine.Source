@using Microsoft.AspNetCore.Components.Authorization
@using XE_Local_AI_Engine.Client.Services.Auth
@inherits LayoutComponentBase

<MudThemeProvider @ref="_mudThemeProvider" @bind-IsDarkMode="_isDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)"/>
        <MudText Typo="Typo.h6" Class="ml-2">XE Local AI Engine</MudText>
        <MudSpacer/>
        <ConnectionStatusBadge/>
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="@(() => _isDarkMode = !_isDarkMode)"/>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Variant="DrawerVariant.Mini" OpenMiniOnHover="true">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
            <MudNavLink Href="/node-binding" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Link">Binding</MudNavLink>
            <MudNavLink Href="/dashboard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            <MudNavLink Href="/node-settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">Node Settings</MudNavLink>
            <MudNavLink Href="/cloud-settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Cloud">Cloud Settings</MudNavLink>
            <MudNavLink Href="/chat" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Chat">Chat</MudNavLink>
            <MudNavLink Href="/models" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CloudDownload">Models</MudNavLink>
            <AuthorizeView Roles="@LocalOperatorAuthorization.OperatorRole">
                <MudNavLink Href="/manager" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MonitorHeart">Manager</MudNavLink>
            </AuthorizeView>
            <MudNavLink Href="/invocations" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Terminal">Invocations</MudNavLink>
            <MudNavLink Href="/invocations/history" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.History">Invocation History</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private MudThemeProvider _mudThemeProvider = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }
    }

}
