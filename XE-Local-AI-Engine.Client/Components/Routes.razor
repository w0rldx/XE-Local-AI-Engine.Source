@using Microsoft.AspNetCore.Components.Authorization
<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <Authorizing>
                <LayoutView Layout="typeof(MainLayout)">
                    <MudAlert Severity="Severity.Info">Authorizing local operator access...</MudAlert>
                </LayoutView>
            </Authorizing>
            <NotAuthorized>
                <LayoutView Layout="typeof(MainLayout)">
                    <MudAlert Severity="Severity.Warning">You are not authorized to view this page.</MudAlert>
                </LayoutView>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1"/>
    </Found>
    <NotFound>
        <PageTitle>Page not found</PageTitle>
        <LayoutView Layout="typeof(MainLayout)">
            <section class="route-not-found">
                <p class="route-not-found__eyebrow">Worker Node</p>
                <h1>Page not found</h1>
                <p>The page you requested does not exist. Use the worker navigation to continue.</p>
                <div class="route-not-found__actions">
                    <a class="route-not-found__link" href="/dashboard">Go to dashboard</a>
                    <a class="route-not-found__link route-not-found__link--secondary" href="/node-binding">Bind this node</a>
                </div>
            </section>
        </LayoutView>
    </NotFound>
</Router>
