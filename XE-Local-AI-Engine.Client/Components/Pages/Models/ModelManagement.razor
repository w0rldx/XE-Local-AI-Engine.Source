@page "/models"
@using OllamaSharp.Models
@using XE_Local_AI_Engine.Client.Services.Chat
@rendermode @(new InteractiveServerRenderMode(false))

@inject IOllamaModelService ModelService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Model Management</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Model Management</MudText>
    <MudSpacer/>
    <MudChip T="string"
             Color="@(_isOllamaAvailable ? Color.Success : Color.Error)"
             Icon="@(_isOllamaAvailable ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error)">
        @(_isOllamaAvailable ? "Ollama Online" : "Ollama Offline")
    </MudChip>
    <MudButton Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="RefreshModels">Refresh
    </MudButton>
</MudStack>

<MudGrid>
    <MudItem xs="12" md="7">
        <MudTable Items="_models"
                  T="Model"
                  Hover="true"
                  Dense="true"
                  OnRowClick="OnRowClick"
                  RowClass="cursor-pointer"
                  Elevation="2">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Size</MudTh>
                <MudTh>Modified</MudTh>
                <MudTh>Family</MudTh>
                <MudTh>Quantization</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Size">@FormatBytes(context.Size)</MudTd>
                <MudTd DataLabel="Modified">@context.ModifiedAt.ToString("yyyy-MM-dd")</MudTd>
                <MudTd DataLabel="Family">@context.Details?.Family</MudTd>
                <MudTd DataLabel="Quantization">@context.Details?.QuantizationLevel</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="@(() => DeleteModel(context))"/>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>@(_isOllamaAvailable ? "No models found." : "Ollama is not available.")</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudItem>

    <MudItem xs="12" md="5">
        @if (_selectedTableModel != null)
        {
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">@_selectedTableModel.Name</MudText>

                <MudSimpleTable Dense="true" Class="mb-3">
                    <tbody>
                    <tr>
                        <td><strong>Parameter Size</strong></td>
                        <td>@(_selectedTableModel.Details?.ParameterSize ?? "—")</td>
                    </tr>
                    <tr>
                        <td><strong>Family</strong></td>
                        <td>@(_selectedTableModel.Details?.Family ?? "—")</td>
                    </tr>
                    <tr>
                        <td><strong>Quantization</strong></td>
                        <td>@(_selectedTableModel.Details?.QuantizationLevel ?? "—")</td>
                    </tr>
                    </tbody>
                </MudSimpleTable>

                @if (_selectedModelDetails != null)
                {
                    @if (!string.IsNullOrWhiteSpace(_selectedModelDetails.Template))
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-1">Template</MudText>
                        <MudText Style="white-space: pre-wrap; font-family: monospace; font-size: 0.8rem;" Class="mb-3">@_selectedModelDetails.Template</MudText>
                    }

                    @if (!string.IsNullOrWhiteSpace(_selectedModelDetails.System))
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-3">
                            <MudText Typo="Typo.subtitle2">System Prompt</MudText>
                            <MudText Style="white-space: pre-wrap;">@_selectedModelDetails.System</MudText>
                        </MudAlert>
                    }

                    @if (!string.IsNullOrWhiteSpace(_selectedModelDetails.License))
                    {
                        <MudExpansionPanels>
                            <MudExpansionPanel Text="License">
                                <MudText Style="white-space: pre-wrap; font-size: 0.8rem;">@_selectedModelDetails.License</MudText>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    }
                }
            </MudPaper>
        }
    </MudItem>
</MudGrid>

<MudPaper Elevation="2" Class="pa-4 mt-4">
    <MudText Typo="Typo.h6" Class="mb-3">Pull New Model</MudText>
    <MudGrid>
        <MudItem xs="12" sm="8">
            <MudTextField @bind-Value="_pullModelName"
                          Placeholder="e.g., llama3:8b, mistral:latest"
                          Variant="Variant.Outlined"
                          Label="Model Name"
                          Disabled="_isPulling"/>
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-center">
            <MudButton OnClick="PullModel"
                       Disabled="@(_isPulling || string.IsNullOrWhiteSpace(_pullModelName))"
                       StartIcon="@Icons.Material.Filled.CloudDownload"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       FullWidth="true">Download
            </MudButton>
        </MudItem>
    </MudGrid>

    @if (_isPulling)
    {
        <MudProgressLinear Value="_pullProgress"
                           Color="Color.Primary"
                           Rounded="true"
                           Size="Size.Large"
                           Class="mt-3"/>
    }

    @if (!string.IsNullOrEmpty(_pullStatus))
    {
        <MudText Class="mt-2" Typo="Typo.body2">@_pullStatus</MudText>
    }

    @if (_pullError != null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-2">@_pullError</MudAlert>
    }
</MudPaper>

@code {
    private List<Model> _models = new();
    private Model? _selectedTableModel;
    private ShowModelResponse? _selectedModelDetails;
    private bool _isOllamaAvailable;
    private string _pullModelName = "";
    private bool _isPulling;
    private double _pullProgress;
    private string _pullStatus = "";
    private string? _pullError;

    protected override async Task OnInitializedAsync()
    {
        _isOllamaAvailable = await ModelService.IsAvailableAsync();
        if (_isOllamaAvailable)
            await LoadModels();
    }

    private async Task LoadModels()
    {
        var models = await ModelService.ListLocalModelsAsync();
        _models = models.ToList();
    }

    private async Task OnRowClick(TableRowClickEventArgs<Model> args)
    {
        _selectedTableModel = args.Item;
        if (_selectedTableModel != null)
        {
            try
            {
                _selectedModelDetails = await ModelService.ShowModelAsync(_selectedTableModel.Name);
            }
            catch
            {
                _selectedModelDetails = null;
            }
        }
    }

    private async Task PullModel()
    {
        if (_isPulling || string.IsNullOrWhiteSpace(_pullModelName)) return;
        _isPulling = true;
        _pullProgress = 0;
        _pullStatus = "Starting download...";
        _pullError = null;
        StateHasChanged();

        try
        {
            await foreach (var response in ModelService.PullModelAsync(_pullModelName.Trim()))
            {
                if (response.Total > 0)
                    _pullProgress = (double)response.Completed / response.Total * 100;
                _pullStatus = response.Status ?? "Downloading...";
                StateHasChanged();
            }

            _pullStatus = "Complete!";
            Snackbar.Add($"Model '{_pullModelName}' downloaded successfully.", Severity.Success);
            _pullModelName = "";
            await LoadModels();
        }
        catch (Exception ex)
        {
            _pullError = ex.Message;
            _pullStatus = "Failed";
        }
        finally
        {
            _isPulling = false;
            StateHasChanged();
        }
    }

    private async Task DeleteModel(Model model)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Model",
            $"Are you sure you want to delete '{model.Name}'? This cannot be undone.",
            "Delete", cancelText: "Cancel");
        if (confirmed ?? false)
        {
            await ModelService.DeleteModelAsync(model.Name);
            Snackbar.Add($"Model '{model.Name}' deleted.", Severity.Info);
            if (_selectedTableModel?.Name == model.Name)
            {
                _selectedTableModel = null;
                _selectedModelDetails = null;
            }

            await LoadModels();
        }
    }

    private async Task RefreshModels()
    {
        _isOllamaAvailable = await ModelService.IsAvailableAsync();
        if (_isOllamaAvailable)
            await LoadModels();
        StateHasChanged();
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1_073_741_824) return $"{bytes / 1_073_741_824.0:F1} GB";
        if (bytes >= 1_048_576) return $"{bytes / 1_048_576.0:F1} MB";
        return $"{bytes / 1024.0:F1} KB";
    }

}
