@page "/chat"
@rendermode @(new InteractiveServerRenderMode(false))
@using XE_Local_AI_Engine.Client.Models.Enums
@using XE_Local_AI_Engine.Client.Services.Chat
@using XE_Local_AI_Engine.Client.Services.Events
@implements IAsyncDisposable

@inject ILocalChatInvocationService ChatService
@inject IOllamaModelService ModelService
@inject IDialogService DialogService
@inject IWorkerEventDispatcher WorkerEventDispatcher

<PageTitle>Local Chat</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    @* Top bar *@
    <MudPaper Elevation="2" Class="pa-3 mb-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudSelect T="string"
                           Value="_selectedModel"
                           ValueChanged="OnModelChanged"
                           Label="Model"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Style="min-width: 220px;"
                           Disabled="@(_isStreaming || !_isOllamaAvailable)">
                    @foreach (var model in _availableModels)
                    {
                        <MudSelectItem Value="@model">@model</MudSelectItem>
                    }
                </MudSelect>
                <MudChip T="string"
                         Color="@(_isOllamaAvailable ? Color.Success : Color.Error)"
                         Size="Size.Small">
                    @(_isOllamaAvailable ? "Online" : "Offline")
                </MudChip>
            </MudStack>
            <MudButton StartIcon="@Icons.Material.Filled.DeleteSweep"
                       Color="Color.Default"
                       Variant="Variant.Outlined"
                       Size="Size.Small"
                       OnClick="ClearChat"
                       Disabled="@_isStreaming">
                Clear
            </MudButton>
        </MudStack>
    </MudPaper>

    @* Chat area *@
    <MudPaper Elevation="1" Class="chat-container" id="chat-container">
        @if (!_isOllamaAvailable)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2">
                Ollama is not available. Please ensure Ollama is running and accessible.
            </MudAlert>
        }
        @if (_messages.Count == 0)
        {
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height: 100%; opacity: 0.5;">
                <MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Large"/>
                <MudText Typo="Typo.body1">Start a conversation...</MudText>
            </MudStack>
        }
        @foreach (var msg in _messages)
        {
            if (msg.Role == "user")
            {
                <div class="chat-bubble-user">
                    <MudPaper Elevation="1" Class="pa-3" Style="background-color: var(--mud-palette-primary); color: white; border-radius: 16px 16px 4px 16px; max-width: 70%; word-wrap: break-word;">
                        @msg.Content
                    </MudPaper>
                </div>
            }
            else
            {
                <div class="chat-bubble-assistant">
                    <MudPaper Elevation="1" Class="pa-3" Style="border-radius: 16px 16px 16px 4px; max-width: 70%; word-wrap: break-word;">
                        @if (!string.IsNullOrEmpty(msg.ThinkingContent))
                        {
                            <div style="margin-bottom: 8px;">
                                <MudButton Size="Size.Small" OnClick="() => msg.ShowThinking = !msg.ShowThinking">
                                    @(!msg.ShowThinking ? "Show thinking" : "Hide thinking")
                                </MudButton>
                                @if (msg.ShowThinking)
                                {
                                    <MudPaper Elevation="0" Class="pa-2 mt-1" Style="background-color: #f5f5f5; font-family: monospace; font-size: 0.85em; color: #666;">
                                        <MudText Typo="Typo.caption">@msg.ThinkingContent</MudText>
                                    </MudPaper>
                                }
                            </div>
                        }
                        @if (msg.IsStreaming && string.IsNullOrEmpty(msg.Content))
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
                        }
                        else
                        {
                            @msg.Content
                            @if (msg.IsStreaming)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ml-1" Style="vertical-align: middle;"/>
                            }
                        }
                    </MudPaper>
                </div>
            }
        }
        <div @ref="_chatBottom"></div>
    </MudPaper>

    @* Input area *@
    <MudPaper Elevation="2" Class="chat-input-area mt-2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudTextField @bind-Value="_userInput"
                          Placeholder="Type a message..."
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Disabled="@(_isStreaming || !_isOllamaAvailable)"
                          OnKeyDown="OnKeyDown"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Send"
                          OnAdornmentClick="SendMessage"
                          AdornmentColor="Color.Primary"/>
            @if (_isStreaming)
            {
                <MudButton Color="Color.Error"
                           Variant="Variant.Outlined"
                           Size="Size.Medium"
                           OnClick="CancelStreaming"
                           StartIcon="@Icons.Material.Filled.Stop">
                    Cancel
                </MudButton>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private const string EmptyAssistantResponseFallback = "The model completed without returning visible text. Please try again or choose a different model.";

    private readonly List<ChatBubble> _messages = new();
    private string _userInput = "";
    private Guid _conversationId;
    private bool _isStreaming;
    private bool _isOllamaAvailable;
    private string _selectedModel = "";
    private List<string> _availableModels = new();
    private CancellationTokenSource? _cts;
    private ElementReference _chatBottom;
    private ChatBubble? _streamingAssistantBubble;

    private sealed class ChatBubble
    {
        public string Role { get; set; } = "";
        public string Content { get; set; } = "";
        public string ThinkingContent { get; set; } = "";
        public bool IsStreaming { get; set; }
        public bool ShowThinking { get; set; } = true;
    }

    protected override async Task OnInitializedAsync()
    {
        WorkerEventDispatcher.InvocationStateChanged += OnInvocationStateChanged;

        var snapshot = await ChatService.GetSnapshotAsync();
        _conversationId = snapshot.ConversationId;
        _isOllamaAvailable = await ModelService.IsAvailableAsync();
        if (_isOllamaAvailable)
        {
            var models = await ModelService.ListLocalModelsAsync();
            _availableModels = models.Select(m => m.Name).ToList();
            _selectedModel = snapshot.SelectedModel;
            if (!_availableModels.Contains(_selectedModel) && _availableModels.Count > 0)
            {
                _selectedModel = _availableModels[0];
                await ChatService.SetModelAsync(_selectedModel);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_messages.Count > 0)
        {
            try
            {
                await _chatBottom.FocusAsync();
            }
            catch
            {
                // scroll not critical
            }
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_userInput) || _isStreaming) return;

        var userMsg = _userInput.Trim();
        _userInput = "";
        _messages.Add(new ChatBubble { Role = "user", Content = userMsg });

        var assistantBubble = new ChatBubble { Role = "assistant", Content = "", IsStreaming = true };
        _messages.Add(assistantBubble);
        _streamingAssistantBubble = assistantBubble;

        _isStreaming = true;
        _cts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            await ChatService.SendMessageAsync(userMsg, _cts.Token);
        }
        catch (OperationCanceledException)
        {
            assistantBubble.Content = string.IsNullOrWhiteSpace(assistantBubble.Content)
                ? "[cancelled]"
                : string.Concat(assistantBubble.Content, " [cancelled]");
        }
        catch (Exception ex)
        {
            assistantBubble.Content = $"Error: {ex.Message}";
        }
        finally
        {
            assistantBubble.IsStreaming = false;
            if (string.IsNullOrWhiteSpace(assistantBubble.Content))
            {
                assistantBubble.Content = EmptyAssistantResponseFallback;
            }

            _streamingAssistantBubble = null;
            _isStreaming = false;
            _cts?.Dispose();
            _cts = null;
            StateHasChanged();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task OnModelChanged(string newModel)
    {
        if (newModel == _selectedModel) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Switch Model",
            "Switching models requires GPU memory reload. The current model will be unloaded and the new model loaded. This may take 10-30 seconds for large models. Continue?",
            "Switch",
            cancelText: "Cancel");
        if (confirmed ?? false)
        {
            _selectedModel = newModel;
            await ChatService.SetModelAsync(newModel);
        }
    }

    private async Task ClearChat()
    {
        _messages.Clear();
        await ChatService.ResetConversationAsync();
        _conversationId = ChatService.ConversationId;
    }

    private void CancelStreaming()
    {
        _cts?.Cancel();
    }

    private void OnInvocationStateChanged(object? sender, InvocationStateChangedEventArgs eventArgs)
    {
        _ = sender;

        if (_streamingAssistantBubble is null || eventArgs.State.ConversationId != _conversationId)
        {
            return;
        }

        switch (eventArgs.State.Status)
        {
            case InvocationStatus.Assigned:
            case InvocationStatus.Running:
                _streamingAssistantBubble.Content = eventArgs.State.StreamedContent;
                _streamingAssistantBubble.ThinkingContent = eventArgs.State.StreamedThinkingContent;
                _streamingAssistantBubble.IsStreaming = true;
                break;
            case InvocationStatus.Completed:
                _streamingAssistantBubble.Content = string.IsNullOrWhiteSpace(eventArgs.State.StreamedContent)
                    ? EmptyAssistantResponseFallback
                    : eventArgs.State.StreamedContent;
                _streamingAssistantBubble.IsStreaming = false;
                break;
            case InvocationStatus.Failed:
                _streamingAssistantBubble.Content = $"Error: {eventArgs.State.Error ?? "Invocation failed."}";
                _streamingAssistantBubble.IsStreaming = false;
                break;
            case InvocationStatus.Cancelled:
                _streamingAssistantBubble.Content = string.IsNullOrWhiteSpace(eventArgs.State.StreamedContent)
                    ? "[cancelled]"
                    : string.Concat(eventArgs.State.StreamedContent, " [cancelled]");
                _streamingAssistantBubble.IsStreaming = false;
                break;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (WorkerEventDispatcher is not null)
        {
            WorkerEventDispatcher.InvocationStateChanged -= OnInvocationStateChanged;
        }

        if (_cts is not null)
        {
            await _cts.CancelAsync();
            _cts.Dispose();
        }

    }

}
