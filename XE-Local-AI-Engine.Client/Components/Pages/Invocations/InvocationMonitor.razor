@page "/invocations"
@using XE_Local_AI_Engine.Client.Services.Events
@using XE_Local_AI_Engine.Client.Services.Invocation
@implements IDisposable
@rendermode @(new InteractiveServerRenderMode(false))
@inject IWorkerEventDispatcher WorkerEventDispatcher
@inject IInvocationRunner InvocationRunner
@inject ILogger<InvocationMonitor> Logger

<PageTitle>Invocation Monitor</PageTitle>

<MudText Typo="Typo.subtitle2">Worker Node</MudText>
<MudText Typo="Typo.h4">Invocation monitor</MudText>
<MudText Typo="Typo.body1" Class="mb-4">Track the current invocation, inspect live streamed output, and cancel a running execution.</MudText>
<MudChip T="string" Color="@GetInvocationChipColor()" Size="Size.Small">@GetInvocationLabel()</MudChip>

@if (!string.IsNullOrWhiteSpace(_actionMessage))
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4">@_actionMessage</MudAlert>
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_errorMessage</MudAlert>
}

<MudGrid Spacing="4" Class="mt-4">
    <MudItem xs="12" md="6">
        @if (_currentInvocation is null)
        {
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6">Current invocation</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4">Shows the active invocation received from the Central Platform.</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No invocation has been assigned yet.</MudText>
                </MudCardContent>
            </MudCard>
        }
        else
        {
            <InvocationCard State="_currentInvocation" Title="Current invocation"/>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="CancelInvocationAsync"
                       Disabled="@(!CanCancel || _isCancelling)">@(_isCancelling ? "Cancelling..." : "Cancel invocation")</MudButton>
        }
    </MudItem>

    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6">Live output</MudText>
                <MudText Typo="Typo.body2" Class="mb-4">Streaming output from the current invocation as it arrives.</MudText>

                @if (_currentInvocation is null)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Live output will appear here when an invocation starts.</MudText>
                }
                else
                {
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Chunks: @_currentInvocation.StreamedChunkCount</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Last update: @FormatTimestamp(_currentInvocation.LastUpdatedAt)</MudChip>

                        @if (_currentInvocation.PendingApproval is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">Approval pending</MudChip>
                        }

                        @if (_currentInvocation.PendingToolCalls.Count > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@_currentInvocation.PendingToolCalls.Count tool call(s) pending</MudChip>
                        }
                    </MudStack>

                    @if (_currentInvocation.PendingApproval is not null)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                            Waiting for approval: @_currentInvocation.PendingApproval.Description
                        </MudAlert>
                    }

                    @if (_currentInvocation.PendingToolCalls.Count > 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                            Active tool calls: @string.Join(", ", _currentInvocation.PendingToolCalls.Select(toolCall => toolCall.ToolName))
                        </MudAlert>
                    }

                    @if (_currentInvocation.LastToolCallResult is not null)
                    {
                        <MudAlert Severity="@(_currentInvocation.LastToolCallResult.Succeeded ? Severity.Success : Severity.Error)" Dense="true" Class="mb-2">
                            Last tool call @(_currentInvocation.LastToolCallResult.Succeeded ? "completed" : "failed"): @_currentInvocation.LastToolCallResult.RequestId
                        </MudAlert>
                    }

                    @if (_currentInvocation.LastApprovalResolution is not null)
                    {
                        <MudAlert Severity="@(_currentInvocation.LastApprovalResolution.Approved ? Severity.Success : Severity.Warning)" Dense="true" Class="mb-2">
                            Last approval was @(_currentInvocation.LastApprovalResolution.Approved ? "approved" : "rejected").
                        </MudAlert>
                    }

                    @if (string.IsNullOrWhiteSpace(_currentInvocation.StreamedContent))
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Waiting for streamed content...</MudText>
                    }
                    else
                    {
                        <MudPaper Class="pa-4 mt-2" Style="font-family: monospace; white-space: pre-wrap; max-height: 400px; overflow-y: auto;" Elevation="0"
                                  Outlined="true">@_currentInvocation.StreamedContent</MudPaper>
                    }
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private InvocationState? _currentInvocation;
    private bool _isCancelling;
    private string? _actionMessage;
    private string? _errorMessage;

    private bool CanCancel =>
        _currentInvocation is not null &&
        _currentInvocation.Status is InvocationStatus.Assigned or InvocationStatus.Running;

    protected override void OnInitialized()
    {
        _currentInvocation = Clone(WorkerEventDispatcher.CurrentInvocation);
        WorkerEventDispatcher.InvocationStateChanged += OnInvocationStateChanged;
    }

    public void Dispose()
    {
        WorkerEventDispatcher.InvocationStateChanged -= OnInvocationStateChanged;
    }

    private Task CancelInvocationAsync()
    {
        if (!CanCancel || _isCancelling || _currentInvocation is null)
        {
            return Task.CompletedTask;
        }

        _isCancelling = true;
        _actionMessage = null;
        _errorMessage = null;

        try
        {
            InvocationRunner.Cancel(_currentInvocation.InvocationId);
            _actionMessage = "Cancellation requested for the current invocation.";
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Invocation cancellation request failed.");
            _errorMessage = "Unable to cancel the current invocation.";
        }
        finally
        {
            _isCancelling = false;
        }

        return InvokeAsync(StateHasChanged);
    }

    private void OnInvocationStateChanged(object? sender, InvocationStateChangedEventArgs eventArgs)
    {
        _ = sender;
        _currentInvocation = Clone(eventArgs.State);
        _ = InvokeAsync(StateHasChanged);
    }

    private string GetInvocationLabel()
    {
        if (_currentInvocation is null)
        {
            return "Idle";
        }

        return _currentInvocation.Status switch
        {
            InvocationStatus.Assigned => "Assigned",
            InvocationStatus.Running => "Running",
            InvocationStatus.Completed => "Completed",
            InvocationStatus.Failed => "Failed",
            InvocationStatus.Cancelled => "Cancelled",
            _ => "Pending"
        };
    }

    private Color GetInvocationChipColor()
    {
        if (_currentInvocation is null) return Color.Default;
        return _currentInvocation.Status switch
        {
            InvocationStatus.Assigned or InvocationStatus.Running => Color.Warning,
            InvocationStatus.Completed => Color.Success,
            InvocationStatus.Failed or InvocationStatus.Cancelled => Color.Error,
            _ => Color.Default
        };
    }

    private static string FormatTimestamp(DateTimeOffset? value)
    {
        return value?.ToLocalTime().ToString("g") ?? "—";
    }

    private static InvocationState? Clone(InvocationState? state)
    {
        if (state is null)
        {
            return null;
        }

        return new InvocationState
        {
            InvocationId = state.InvocationId,
            ConversationId = state.ConversationId,
            Status = state.Status,
            StreamedContent = state.StreamedContent,
            StreamedChunkCount = state.StreamedChunkCount,
            StartedAt = state.StartedAt,
            LastUpdatedAt = state.LastUpdatedAt,
            CompletedAt = state.CompletedAt,
            Error = state.Error,
            FailureCategory = state.FailureCategory,
            ModelUsed = state.ModelUsed,
            PendingApproval = state.PendingApproval,
            LastApprovalResolution = state.LastApprovalResolution,
            PendingToolCalls = [.. state.PendingToolCalls],
            LastToolCallResult = state.LastToolCallResult
        };
    }

}
