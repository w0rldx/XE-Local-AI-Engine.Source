@page "/node-settings"
@using XE_Local_AI_Engine.Client.Services.Capabilities
@using XE_Local_AI_Engine.Client.Services.NodeSettings
@rendermode @(new InteractiveServerRenderMode(false))

@inject INodeSettingsStore NodeSettingsStore
@inject ICapabilityReporter CapabilityReporter
@inject ILogger<NodeSettings> Logger

<PageTitle>Node Settings</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <div>
        <MudText Typo="Typo.subtitle2">Worker Node</MudText>
        <MudText Typo="Typo.h4">Node settings</MudText>
        <MudText Typo="Typo.body1">Configure non-secret worker behavior and report it to the central platform.</MudText>
    </div>
    <MudSpacer/>
    <MudChip T="string" Color="Color.Info" Icon="@Icons.Material.Filled.Settings">Local settings</MudChip>
</MudStack>

@if (!string.IsNullOrWhiteSpace(_successMessage))
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4">@_successMessage</MudAlert>
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_errorMessage</MudAlert>
}

<MudAlert Severity="Severity.Info" Class="mb-4">
    These settings do not contain secrets. When the worker is connected, saving reports the current settings to the C0re platform so they can be stored with this node.
</MudAlert>

<MudGrid>
    <MudItem xs="12" md="7">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h5" Class="mb-4">Message request handling</MudText>
                <MudNumericField T="int"
                                 Label="Maximum message request timeout"
                                 HelperText="Hung message requests are cancelled after this many seconds."
                                 @bind-Value="_maxMessageRequestTimeoutSeconds"
                                 Min="StoredNodeSettings.MinMaxMessageRequestTimeoutSeconds"
                                 Max="StoredNodeSettings.MaxMaxMessageRequestTimeoutSeconds"
                                 Step="30"
                                 Variant="Variant.Outlined"
                                 Disabled="_isSaving"
                                 Immediate="true"
                                 Class="mb-4"/>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@(_isSaving || !CanSave)"
                           OnClick="SaveAsync">
                    @(_isSaving ? "Saving..." : "Save settings")
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Disabled="_isSaving"
                           OnClick="LoadSettingsAsync">
                    Reload
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="5">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h5" Class="mb-4">Current local state</MudText>
                <MudSimpleTable Dense="true" Hover="true">
                    <tbody>
                    <tr>
                        <td>Max timeout</td>
                        <td>@_maxMessageRequestTimeoutSeconds seconds</td>
                    </tr>
                    <tr>
                        <td>Allowed range</td>
                        <td>@StoredNodeSettings.MinMaxMessageRequestTimeoutSeconds–@StoredNodeSettings.MaxMaxMessageRequestTimeoutSeconds seconds</td>
                    </tr>
                    </tbody>
                </MudSimpleTable>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private int _maxMessageRequestTimeoutSeconds = StoredNodeSettings.DefaultMaxMessageRequestTimeoutSeconds;
    private bool _isSaving;
    private string? _successMessage;
    private string? _errorMessage;

    private bool CanSave =>
        _maxMessageRequestTimeoutSeconds >= StoredNodeSettings.MinMaxMessageRequestTimeoutSeconds
        && _maxMessageRequestTimeoutSeconds <= StoredNodeSettings.MaxMaxMessageRequestTimeoutSeconds;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettingsAsync();
    }

    private async Task LoadSettingsAsync()
    {
        ClearMessages();

        try
        {
            var settings = await NodeSettingsStore.LoadAsync();
            _maxMessageRequestTimeoutSeconds = settings.MaxMessageRequestTimeoutSeconds;
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Node settings could not be loaded.");
            _errorMessage = "Node settings could not be loaded.";
        }
    }

    private async Task SaveAsync()
    {
        if (_isSaving || !CanSave)
        {
            return;
        }

        _isSaving = true;
        ClearMessages();

        try
        {
            await NodeSettingsStore.SaveAsync(new StoredNodeSettings
            {
                MaxMessageRequestTimeoutSeconds = _maxMessageRequestTimeoutSeconds
            });

            await ReportCapabilitiesBestEffortAsync();
            _successMessage = "Node settings saved locally and queued for platform reporting.";
        }
        catch (IOException exception)
        {
            Logger.LogWarning(exception, "Node settings could not be written.");
            _errorMessage = "Node settings could not be saved locally.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ReportCapabilitiesBestEffortAsync()
    {
        try
        {
            await CapabilityReporter.ReportToApiAsync();
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Capability refresh after node settings change failed.");
        }
    }

    private void ClearMessages()
    {
        _successMessage = null;
        _errorMessage = null;
    }
}
