<?xml version="1.0" encoding="utf-8"?>
<!--
  Framework-dependent publish profile for the Windows Velopack portable package.

  The main application deliberately redistributes neither the Microsoft .NET runtime nor its own apphost. The separate
  XE-Local-AI-Engine.WindowsLauncher C# project publishes a framework-dependent Microsoft apphost under MIT, checks the
  pinned ASP.NET Core runtime floor, and starts this adjacent managed DLL through the user's dotnet.exe. This preserves
  a double-click/Velopack executable entry point without putting coreclr or other .NET runtime binaries in the Windows
  artifact.

  Why PublishTrimmed=false:
    EF Core, Serilog, FastEndpoints, and MEAI use heavy reflection at runtime (attribute
    scanning, expression trees, source-generated interceptors, plugin discovery). The .NET
    trimmer cannot trace all reachable members through reflection and will silently remove
    code that is needed at runtime, causing crashes or missing functionality. Keep trimming
    off until every dependency ships a trim-safe annotation and the app carries a full
    trim-compatibility smoke suite.

  Why UseAppHost=false:
    SelfContained=false alone would still generate a platform-specific executable host for the main application. The
    official Windows package instead overlays the dedicated C# launcher project, so this publish emits only the
    DLL/runtimeconfig/deps entry point plus its application dependencies.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net10.0\win-x64\publish\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>$(DotNetRuntimeVersion)</RuntimeFrameworkVersion>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <UseAppHost>false</UseAppHost>
    <RollForward>LatestPatch</RollForward>
    <PublishTrimmed>false</PublishTrimmed>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
