<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-file self-contained publish profile for win-x64.

  Why PublishTrimmed=false:
    EF Core, Serilog, FastEndpoints, and MEAI use heavy reflection at runtime (attribute
    scanning, expression trees, source-generated interceptors, plugin discovery). The .NET
    trimmer cannot trace all reachable members through reflection and will silently remove
    code that is needed at runtime, causing crashes or missing functionality. Keep trimming
    off until every dependency ships a trim-safe annotation and the app carries a full
    trim-compatibility smoke suite.

  Why IncludeNativeLibrariesForSelfExtract=true:
    The single-file bundle cannot embed native DLLs inside the .exe on Windows without
    this flag. Without it, e_sqlite3.dll (Microsoft.Data.Sqlite / EF Core SQLite provider)
    and the libsodium / NSec native library are left as loose files beside the binary,
    breaking the "one file" contract. With the flag set, the runtime extracts them to a
    per-user temp directory at first launch and loads them from there on every subsequent
    run. The Job Object assigned to llama-server children is unaffected — the extraction
    directory is read-only at that point.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net10.0\win-x64\publish\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>$(DotNetRuntimeVersion)</RuntimeFrameworkVersion>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
