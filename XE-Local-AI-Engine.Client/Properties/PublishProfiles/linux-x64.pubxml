<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-file self-contained publish profile for linux-x64.

  Why PublishTrimmed=false:
    EF Core, Serilog, FastEndpoints, and MEAI use heavy reflection at runtime (attribute
    scanning, expression trees, source-generated interceptors, plugin discovery). The .NET
    trimmer cannot trace all reachable members through reflection and will silently remove
    code that is needed at runtime, causing crashes or missing functionality. Keep trimming
    off until every dependency ships a trim-safe annotation and the app carries a full
    trim-compatibility smoke suite.

  Why IncludeNativeLibrariesForSelfExtract=true:
    The single-file bundle cannot embed native shared libraries (.so files) inside the
    executable on Linux without this flag. Without it, e_sqlite3.so (Microsoft.Data.Sqlite /
    EF Core SQLite provider) and libsodium.so (used by NSec.Cryptography for key
    management and encryption) are left as loose files beside the binary, breaking the
    "one file" contract. With the flag set, the runtime extracts them to a per-app temp
    directory at first launch and loads them from there on every subsequent run.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net10.0\linux-x64\publish\</PublishDir>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>$(DotNetRuntimeVersion)</RuntimeFrameworkVersion>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
