[Unit]
Description=XE Local AI Engine HostAgent
Documentation=https://c0re.local/xe-local-ai-engine/host-agent
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/share/xe-host-agent/bin/XE-Local-AI-Engine.HostAgent.Linux
Restart=on-failure
RestartSec=5s
Environment=ASPNETCORE_ENVIRONMENT=Production

[Install]
WantedBy=default.target
