<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>XE_Local_AI_Engine.Providers.LlamaServer</RootNamespace>
    <!-- Required by LibraryImport source-gen marshalling stubs (Linux killpg + Windows Job Object P/Invoke). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI"/>
    <PackageReference Include="Azure.AI.OpenAI"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <!-- The reranker's named client strips the Aspire-installed standard pipeline off its non-idempotent
         /v1/rerank POST (RemoveAllResilienceHandlers), as the whisper.cpp and sd.cpp runtimes already do. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XE-Local-AI-Engine.Providers.Abstractions\XE-Local-AI-Engine.Providers.Abstractions.csproj"/>
    <!-- The shared OpenAI-compatible wire layer (client construction + the request-body patch/chaining discipline).
         A deliberate, reviewed second edge for a provider project: it is a leaf transport library with no project
         references of its own, not a sibling provider, so the "providers never reach across to each other" rule the
         layer-dependency tests freeze is unaffected. -->
    <ProjectReference Include="..\XE-Local-AI-Engine.Providers.OpenAICompatible.Core\XE-Local-AI-Engine.Providers.OpenAICompatible.Core.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Tests construct the internal OS/arch-pinned constructors + invoke the pure variant-selection rule directly,
         rather than shelling out to GPU probes or downloading real binaries. -->
    <InternalsVisibleTo Include="XE-Local-AI-Engine.Tests" />
    <!-- The host's raw-model proxy forwarder matches the SAME "the child is gone" exception family this provider
         already recognizes (DeferredLlamaServerChatClient.IsServerGone). A private copy of that match in the host is
         exactly how the two would come to disagree about what a force-eject looks like on the wire. Mirrors the
         grant Providers.Ollama already makes to the host. -->
    <InternalsVisibleTo Include="XE-Local-AI-Engine.Client" />
  </ItemGroup>

</Project>
