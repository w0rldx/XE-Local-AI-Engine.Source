<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>XE_Local_AI_Engine.Providers.Ollama</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions"/>
    <!-- Direct, not transitive-through-OllamaSharp: OllamaLocalModelProvider.CreateEmbeddingGenerator applies the
         MEAI embedding-generator OpenTelemetry hop, and a telemetry-privacy boundary must not ride a dependency
         edge an OllamaSharp bump could drop. Version comes from CPM, so this adds no version surface. -->
    <PackageReference Include="Microsoft.Extensions.AI"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <!-- PrivateAssets="compile" is the OllamaSharp wall: runtime assets still flow to consumers so the
         node runs, but no project referencing this one can compile against an OllamaSharp type, which is what a
         PackageReference allowlist alone cannot prevent. -->
    <PackageReference Include="OllamaSharp" PrivateAssets="compile"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XE-Local-AI-Engine.Providers.Abstractions\XE-Local-AI-Engine.Providers.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XE-Local-AI-Engine.Tests" />
  </ItemGroup>

</Project>
