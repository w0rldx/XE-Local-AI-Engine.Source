{
	"name": "xe-local-ai-engine.client.react",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.27.0",
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"dev": "vite --port 5173",
		"start": "vite --port 3000",
		"licenses:generate": "node scripts/GenerateLicenses.mjs",
		"licenses:check": "pnpm run licenses:generate && git diff --exit-code -- src/features/about/data/third-party-licenses.generated.json",
		"licenses:bundle": "node scripts/FrontendLicenseCorpus.mjs",
		"dependencies:refresh": "node scripts/RefreshDependencies.mjs",
		"build": "pnpm run lint && pnpm run build:bundle",
		"build:bundle": "vite build && pnpm run licenses:bundle && pnpm run bundle:check",
		"build:e2e": "vite build",
		"serve": "vite preview",
		"lint": "tsc --noEmit && node scripts/CheckEventCurrentTargetInUpdaters.mjs && node scripts/CheckTestsHaveAssertions.mjs && node scripts/CheckI18nDefaults.mjs && node scripts/SortLocales.mjs --check && node scripts/CheckMantineTestTheme.mjs && biome lint && biome format src scripts && stylelint \"src/**/*.css\"",
		"lint:fix": "tsc --noEmit && node scripts/CheckEventCurrentTargetInUpdaters.mjs && node scripts/CheckTestsHaveAssertions.mjs && node scripts/CheckI18nDefaults.mjs && node scripts/SortLocales.mjs && node scripts/CheckMantineTestTheme.mjs && biome lint --fix && stylelint \"src/**/*.css\" --fix",
		"format": "biome format --write src scripts",
		"check": "biome format --write src scripts && biome lint",
		"doctor": "react-doctor . --yes --no-telemetry --no-supply-chain --no-cache --no-dead-code --no-parallel --blocking none --no-color",
		"knip": "node scripts/CheckKnipBaseline.mjs",
		"knip:report": "knip --config Knip.ts",
		"depcruise": "node scripts/CheckDependencyBaseline.mjs",
		"depcruise:report": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
		"signalr:check": "node scripts/CheckSignalrProxySync.mjs",
		"bundle:check": "node scripts/CheckBundleBudget.mjs",
		"locales:sort": "node scripts/SortLocales.mjs",
		"node:check": "node scripts/CheckNodeMajor.mjs",
		"acceptance": "pnpm run node:check && pnpm run licenses:check && pnpm run validate && pnpm run test:coverage:check && pnpm run test:tooling && pnpm run build:bundle",
		"validate": "pnpm run lint && pnpm run knip && pnpm run signalr:check && pnpm run depcruise",
		"spellCheck": "cspell src/**/*.ts{,x} --no-progress",
		"test": "vitest run",
		"test:tooling": "node --test scripts/*.test.mjs",
		"test:coverage": "vitest run --coverage",
		"test:coverage:check": "node scripts/RunCoverageCheck.mjs",
		"openapi:fetch": "node scripts/FetchOpenapi.mjs",
		"openapi:generate": "openapi-ts --file OpenapiTs.config.ts",
		"openapi": "pnpm run openapi:fetch && pnpm run openapi:generate",
		"openapi:check": "pnpm run openapi:generate && git diff --exit-code -- openapi src/core/api/generated",
		"openapi:check:live": "node scripts/CheckLiveOpenapi.mjs && pnpm run openapi:check"
	},
	"dependencies": {
		"@mantine/charts": "^9.7.2",
		"@mantine/colors-generator": "^9.7.2",
		"@mantine/core": "^9.7.2",
		"@mantine/hooks": "^9.7.2",
		"@mantine/notifications": "^9.7.2",
		"@microsoft/signalr": "^10.0.11",
		"@t3-oss/env-core": "^0.13.11",
		"@tabler/icons-react": "^3.49.0",
		"@tanstack/react-query": "^5.104.3",
		"@tanstack/react-router": "^1.170.44",
		"@tanstack/react-virtual": "^3.14.20",
		"@xyflow/react": "12.12.0",
		"axios": "^1.20.0",
		"clsx": "^2.1.1",
		"fflate": "^0.8.3",
		"framer-motion": "^14.3.0",
		"i18next": "^26.4.7",
		"i18next-browser-languagedetector": "^8.2.1",
		"idb": "^8.0.4",
		"monaco-editor": "^0.57.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-error-boundary": "^6.1.6",
		"react-i18next": "^17.0.19",
		"react-joyride": "3.2.0",
		"react-markdown": "^10.1.0",
		"react-syntax-highlighter": "^16.1.2",
		"recharts": "^3.10.1",
		"remark": "^15.0.1",
		"remark-gfm": "^4.0.1",
		"rrweb": "2.1.7",
		"strip-markdown": "^6.0.0",
		"three": "0.186.1",
		"zod": "^4.6.7",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@cspell/dict-de-de": "^4.1.3",
		"@cspell/dict-en_us": "4.4.41",
		"@hey-api/openapi-ts": "0.99.0",
		"@tanstack/devtools-vite": "^0.8.5",
		"@tanstack/react-devtools": "^0.10.13",
		"@tanstack/react-query-devtools": "^5.104.3",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/router-plugin": "^1.168.46",
		"@testing-library/react": "^16.3.3",
		"@total-typescript/ts-reset": "0.6.1",
		"@types/node": "22.3.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@types/three": "0.186.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/coverage-v8": "^5.0.5",
		"@vitest/ui": "^5.0.5",
		"cspell": "^10.4.0",
		"dependency-cruiser": "^18.6.0",
		"fake-indexeddb": "^6.2.5",
		"jsdom": "30.0.1",
		"knip": "6.41.0",
		"msw": "2.15.0",
		"postcss": "^8.5.30",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"react-doctor": "0.9.18",
		"stylelint": "^17.16.0",
		"stylelint-config-standard": "^40.0.0",
		"typescript": "^6.0.3",
		"unocss": "^66.11.0",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "4.64.7"
	}
}
