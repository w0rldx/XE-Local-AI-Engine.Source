{
	"compilerOptions": {
		"composite": true,
		"skipLibCheck": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"allowImportingTsExtensions": true,
		"tsBuildInfoFile": "./node_modules/.cache/tsconfig.node.tsbuildinfo"
	},
	"include": ["vite.config.ts", "vite-plugins/**/*.ts"]
}
