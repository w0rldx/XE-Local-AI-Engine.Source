{
	"$schema": "https://react.doctor/schema/config.json",
	"ignore": {
		"files": [
			"src/core/api/generated/**",
			"src/routeTree.gen.ts",
			"**/*.gen.ts",
			"src/core/api/Generated.runtime.ts",
			"src/core/api/axios/AxiosInstance.ts"
		]
	},
	// A form owns its draft and reports a flag about it (dirty, acknowledged, signed in) to the page from an effect,
	// which is what drives the page's unsaved-changes guard. That is deliberate, and these two rules flag only it.
	"rules": {
		"react-doctor/no-prop-callback-in-effect": "off",
		"react-doctor/no-pass-live-state-to-parent": "off"
	}
}
