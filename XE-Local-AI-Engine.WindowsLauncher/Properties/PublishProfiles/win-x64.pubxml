<?xml version="1.0" encoding="utf-8"?>
<!--
  Framework-dependent Windows x64 launcher. The generated Microsoft apphost supplies the standard missing-.NET launch
  experience, while the repository-owned C# code validates the ASP.NET Core runtime and the adjacent application
  payload before invoking the main managed DLL. No .NET runtime is included.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>$(DotNetRuntimeVersion)</RuntimeFrameworkVersion>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <UseAppHost>true</UseAppHost>
    <RollForward>LatestPatch</RollForward>
    <PublishTrimmed>false</PublishTrimmed>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
