<?xml version="1.0" encoding="utf-8"?>
<!--
  Framework-dependent terminal client for win-x64. Like WindowsLauncher it keeps the Microsoft apphost, so `xe.exe` is
  its own console executable (stdout and the exit code reach the shell directly) while no .NET runtime ships. The
  apphost's MIT license and notices already land in the shared publish directory through WindowsLauncher.
-->
<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>$(DotNetRuntimeVersion)</RuntimeFrameworkVersion>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <UseAppHost>true</UseAppHost>
    <RollForward>LatestPatch</RollForward>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
