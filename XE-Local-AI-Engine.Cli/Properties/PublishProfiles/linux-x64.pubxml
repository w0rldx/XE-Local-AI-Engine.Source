<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-file self-contained terminal client for linux-x64, published into the same directory as the Client and
  Desktop payloads so `xe` ships beside them. Same shape as the Client and Desktop Linux profiles: untrimmed, native
  libraries extracted at first launch.
-->
<Project>
  <PropertyGroup>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>$(DotNetRuntimeVersion)</RuntimeFrameworkVersion>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
</Project>
