{
  // Project-level opencode config. Schema: https://opencode.ai/docs/config/
  // Updates here override global ~/.config/opencode/opencode.jsonc.
  "$schema": "https://opencode.ai/config.json",

  // Primary agent invoked when no explicit agent is selected. Confirmed runtime name
  // via `opencode agent list` 2026-05-06; nested .opencode/agents/<category>/openagent.md loads
  // under PascalCase frontmatter name.
  "default_agent": "OpenAgent",

  // Per-agent / per-tool permissions live in agent frontmatter (.opencode/agents/**/*.md
  // `permission` block). The repo-level map is intentionally empty so the project does not
  // hide global operator policy; write/edit enforcement for this setup is handled by the
  // approval-gate plugin plus explicit agent frontmatter rules.
  "permission": {},

  // MCP servers active for this project. Empty: code-search-mcp is legacy (see
  // .opencode/legacy/) and not loaded. Global config (context7, microsoft-learn, exa) still
  // applies via merge.
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },

  // Project-local plugins loaded by opencode. Migrated from .opencode/hooks/ in
  // .omc/plans/2026-05-06-shared-context-remediation.md Step 10.
  // Plugins under .opencode/plugins/ are auto-discovered; listing them here makes
  // the dependency explicit and CI-checkable.
  //
  // approval-gate options:
  //   mode            — "off" (default) | "warn" (telemetry + reminder) | "block" (reject)
  //                     Rollback: set OPENCODE_APPROVAL_GATE_MODE=warn in env (no commit needed).
  //                     Disable entirely: OMC_SKIP_APPROVAL_GATE=1 OR remove plugin tuple.
  //   extraAllowPrefixes — paths allowed without session approval (routine operator paths).
  //                     Built-ins always allowed: .omc/, .opencode/.cache/
  //                     Governance paths (.opencode/agents, scripts, tools, context) REMOVED (AC6.2).
  //                     Builder agents (OpenSystemBuilder, OpenRepoManager) have explicit
  //                     permission.edit allow in their frontmatter instead (AC6.4).
  //   blockPaths      — glob patterns for phased block rollout (P1.7a). Empty = full-mode.
  //                     See .opencode/plugins/block-paths-v1.txt for the canonical list.
  //
  // AC6.2 — block mode soak window started 2026-05-15; target close 2026-05-29 (14 days).
  // AC6.2 follow-up is tracked by the approval-block soak window; rollback remains OPENCODE_APPROVAL_GATE_MODE=warn (no commit).
  //
  // embedding-warmup: session-start safeguard. Pings Ollama + warms the external
  //   knowledge embedding model on first message; if Ollama is down or the model
  //   is missing it emits a LOUD stderr banner and injects a system-reminder with
  //   the exact fix (ollama serve / ollama pull). Non-blocking, never throws.
  //   Bypass: OMC_SKIP_EMBEDDING_WARMUP=1
  "plugin": [
    ".opencode/plugins/raw-discovery-telemetry.ts",
    ".opencode/plugins/embedding-warmup.ts",
    [
      ".opencode/plugins/approval-gate.ts",
      {
        "mode": "block",
        "extraAllowPrefixes": [
          // Telemetry, session cache, and tool scratch — written during normal agent runs
          ".opencode/.cache",
          // External context scratch dir
          ".tmp/external-context",
          // Operator handoff scratch dir (exists at runtime)
          ".opencode/handoffs"
        ],
        "blockPaths": []
      }
    ],
    ".opencode/plugins/ntfy-notifications.ts",
    ".opencode/plugins/devops-env-check.ts"
  ]
}
