<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>XE_Local_AI_Engine.AI.Agent</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI"/>
    <PackageReference Include="Microsoft.Agents.AI.Abstractions"/>
    <PackageReference Include="Microsoft.Agents.AI.Workflows"/>
    <!-- Debug-only: only ships as a preview package and is used solely by the DevUI agent
         registration (AgentDevUiExtensions, #if DEBUG); the Release build must not carry it. -->
    <PackageReference Include="Microsoft.Agents.AI.Hosting" Condition="'$(Configuration)' == 'Debug'"/>
    <PackageReference Include="Microsoft.Extensions.AI"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations"/>
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions"/>
    <PackageReference Include="Scrutor"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Instructions/*.txt"/>
  </ItemGroup>

</Project>
