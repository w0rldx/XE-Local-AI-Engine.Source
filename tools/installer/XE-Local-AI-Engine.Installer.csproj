<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>XE_Local_AI_Engine.Installer</RootNamespace>
    <AssemblyName>xe-installer</AssemblyName>
    <!-- Publish-time properties (-r win-x64 -p:PublishSingleFile=true -p:SelfContained=true
         -p:PublishTrimmed=true -p:EnableCompressionInSingleFile=true) are passed by the
         packaging script, NOT hard-baked, so a plain `dotnet build` for unit tests stays fast
         and cross-platform (Lane A builds and tests on the Linux CI box). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- No Version: CPM (root Directory.Packages.props) supplies the pinned versions. -->
    <PackageReference Include="YamlDotNet" />
    <!-- DPAPI for the admin-token protection (config-write phase); the Windows-only call site is guarded. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

</Project>
