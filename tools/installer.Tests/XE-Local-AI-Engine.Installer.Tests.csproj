<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>XE_Local_AI_Engine.Installer.Tests</AssemblyName>
    <OutputType>Exe</OutputType>
    <RootNamespace>XE_Local_AI_Engine.Installer.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage"/>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport"/>
    <PackageReference Include="Microsoft.Testing.Platform"/>
    <PackageReference Include="NSubstitute"/>
    <PackageReference Include="TUnit"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\installer\XE-Local-AI-Engine.Installer.csproj"/>
    <!-- Reuse the repo's shared assertion helper (TUnit + AssertEx is the repo convention; Shouldly is not in CPM). -->
    <Compile Include="..\..\XE-Local-AI-Engine.Tests\Testing\AssertionException.cs" Link="Testing\AssertionException.cs"/>
    <Compile Include="..\..\XE-Local-AI-Engine.Tests\Testing\AssertEx.cs" Link="Testing\AssertEx.cs"/>
  </ItemGroup>

</Project>
