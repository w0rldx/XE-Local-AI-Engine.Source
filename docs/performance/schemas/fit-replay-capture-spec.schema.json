{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xe-local-ai-engine.local/schemas/fit-replay-capture-spec.schema.json",
  "title": "llama.cpp fit and replay capture specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "capture_id", "phase", "binaries", "commands", "launch_vectors", "resource_acceptance", "coverage"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "fit-replay-capture" },
    "capture_id": { "type": "string", "minLength": 1 },
    "phase": { "const": "fit-proof" },
    "binaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server", "fit_helper"],
      "properties": {
        "server": { "$ref": "#/$defs/binary" },
        "fit_helper": { "$ref": "#/$defs/binary" }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_verbosity", "verbose", "fit_params", "explore", "replay"],
      "properties": {
        "default_verbosity": { "$ref": "#/$defs/command" },
        "verbose": { "$ref": "#/$defs/command" },
        "fit_params": { "$ref": "#/$defs/command" },
        "explore": { "$ref": "#/$defs/command" },
        "replay": { "$ref": "#/$defs/command" }
      }
    },
    "launch_vectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explore", "replay"],
      "properties": {
        "explore": { "$ref": "#/$defs/argv" },
        "replay": { "$ref": "#/$defs/argv" }
      }
    },
    "resource_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_delta_percent"],
      "properties": {
        "max_delta_percent": { "type": "number", "minimum": 0 }
      }
    },
    "coverage": { "type": "object", "required": ["unvalidated"], "properties": { "unvalidated": { "type": "array" } } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "binary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "tag": { "type": "string" },
        "provenance": { "type": "string" },
        "backend": { "type": "string" }
      }
    },
    "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "argv", "repeats", "timeout_seconds"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "argv": { "$ref": "#/$defs/argv" },
        "cwd": { "type": "string" },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "warmups": { "type": "integer", "minimum": 0 },
        "repeats": { "type": "integer", "minimum": 1 },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "expected_timeout": { "type": "boolean" }
      }
    }
  }
}
