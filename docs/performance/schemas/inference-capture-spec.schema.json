{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xe-local-ai-engine.local/schemas/inference-capture-spec.schema.json",
  "title": "Inference benchmark capture specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "capture_id", "phase", "models", "corpus", "runtime", "framework", "benchmark", "coverage", "commands"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "inference-benchmark-capture" },
    "capture_id": { "type": "string", "minLength": 1 },
    "phase": { "enum": ["baseline", "rebaseline", "experiment"] },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "role", "quant", "path", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": { "enum": ["chat", "embedding", "reranker"] },
          "quant": { "type": "string", "minLength": 1 },
          "repository": { "type": "string" },
          "revision": { "type": "string" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "revision": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": true,
      "required": ["tag", "provenance", "backend", "path", "sha256"],
      "properties": {
        "tag": { "type": "string", "minLength": 1 },
        "provenance": { "enum": ["managed-source-build", "pinned-prebuilt", "BYO"] },
        "backend": { "enum": ["cuda", "vulkan", "cpu", "other"] },
        "build_options": { "type": "array", "items": { "type": "string" } },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source_commit", "maf_version", "meai_version", "openai_version"],
      "properties": {
        "source_commit": { "type": "string", "minLength": 7 },
        "maf_version": { "type": "string", "minLength": 1 },
        "meai_version": { "type": "string", "minLength": 1 },
        "openai_version": { "type": "string", "minLength": 1 },
        "mcp_version": { "type": "string" }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": true,
      "required": ["cache_state", "cache_preparation", "ambient_load_policy", "acceptance_rule"],
      "properties": {
        "cache_state": { "enum": ["cold", "warm", "controlled-mixed"] },
        "cache_preparation": { "type": "string", "minLength": 1 },
        "ambient_load_policy": { "type": "string", "minLength": 1 },
        "acceptance_rule": { "type": "string", "minLength": 1 },
        "throughput_minimum_improvement_percent": { "type": "number", "minimum": 0 },
        "memory_maximum_regression_percent": { "type": "number", "minimum": 0 },
        "statistics": { "const": "median-and-nearest-rank-p95" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unvalidated"],
      "properties": {
        "unvalidated": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "reason"],
            "properties": {
              "target": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/command" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "argv", "warmups", "repeats", "timeout_seconds"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "cwd": { "type": "string" },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "warmups": { "type": "integer", "minimum": 0 },
        "repeats": { "type": "integer", "minimum": 1 },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "expected_timeout": { "type": "boolean" }
      }
    }
  }
}
