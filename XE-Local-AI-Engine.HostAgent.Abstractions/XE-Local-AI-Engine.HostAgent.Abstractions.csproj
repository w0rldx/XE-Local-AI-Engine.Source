<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>XE_Local_AI_Engine.HostAgent.Abstractions</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <HostAgentSchema Include="Schemas\*.schema.json"/>
  </ItemGroup>

  <Target Name="EmitHostAgentSchemas" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildThisFileDirectory)..\Plans\artifacts\schemas"/>
    <Copy SourceFiles="@(HostAgentSchema)" DestinationFolder="$(MSBuildThisFileDirectory)..\Plans\artifacts\schemas" SkipUnchangedFiles="true"/>
  </Target>

</Project>
