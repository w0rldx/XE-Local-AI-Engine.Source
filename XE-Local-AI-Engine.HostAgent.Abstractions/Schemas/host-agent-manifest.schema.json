{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c0re.local/schemas/xe-host-agent/host-agent-manifest.schema.json",
  "title": "XE HostAgent Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeMode",
    "models",
    "containers",
    "runtimeLimits"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "runtimeMode": {
      "type": "string",
      "enum": [
        "managed",
        "native",
        "external"
      ]
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootstrapModel",
        "defaultChatModel"
      ],
      "properties": {
        "bootstrapModel": {
          "type": "string",
          "minLength": 1
        },
        "defaultChatModel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "containers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "image",
          "network",
          "environment",
          "volumes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "image": {
            "type": "string",
            "pattern": "^(?!.*:latest@sha256:).+:.+@sha256:[A-Fa-f0-9]{64}$"
          },
          "network": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "volumes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "target",
                "readOnly"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "readOnly": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "runtimeLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxRuntimeDiskGb",
        "stopDrainTimeoutSeconds"
      ],
      "properties": {
        "maxRuntimeDiskGb": {
          "type": "integer",
          "minimum": 1
        },
        "stopDrainTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
