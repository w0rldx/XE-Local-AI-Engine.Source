# syntax=docker/dockerfile:1.7
# ---------------------------------------------------------------------------
# Production image for the XE node web server (xe-node-web-server).
#
# BUILD CONTEXT IS THE PARENT C0re REPO ROOT, NOT the app repo.
# The app at Apps/XE-Local-AI-Engine references XE-Local-AI-Engine.AI.Contracts,
# which now lives INSIDE the app tree
# (Apps/XE-Local-AI-Engine/XE-Local-AI-Engine.AI.Contracts). MSBuild
# also walks up from each project to the nearest Directory.Build.props /
# Directory.Packages.props (central package management is enabled), so the build
# must reproduce that directory layout. We keep the C0re repo root as the context
# root so the parent props files remain available to the MSBuild Directory.* walk.
#
# Build invocation (records a registry-independent config Id):
#   docker build --provenance=false --sbom=false --platform linux/amd64 \
#     -f Apps/XE-Local-AI-Engine/docker/Dockerfile.xe-node \
#     -t ghcr.io/c0re/xe-local-ai-engine:0.1.0-rc.1 \
#     <C0re-repo-root>
#
# Per-Dockerfile ignore lives next to this file as Dockerfile.xe-node.dockerignore
# (BuildKit picks it up automatically); do NOT add a .dockerignore at the parent
# root because other builds in the parent repo rely on a different ignore set.
# ---------------------------------------------------------------------------

ARG APP_DIR=Apps/XE-Local-AI-Engine
ARG REACT_DIR=${APP_DIR}/XE-Local-AI-Engine.Client.React

# ---------------------------------------------------------------------------
# Stage 1 — build the React SPA.
# pnpm is the repo's package manager (packageManager pnpm@11.2.2, pnpm-lock.yaml).
# The lockfile-first copy keeps the dependency layer cached across source-only
# changes. We invoke `vite build` directly (the `build:e2e` script) rather than
# the `build` script: lint / typecheck / stylelint are CI gates, not image
# concerns, and pulling them into the image build would add tooling weight and
# fail the build on style nits that do not affect the served bundle.
# ---------------------------------------------------------------------------
FROM node:24.14-alpine AS react
ARG REACT_DIR
WORKDIR /react

# Pin pnpm via corepack — explicit prepare locks the version in the cache layer
# so the downstream `pnpm install` picks up the exact binary without a network hit.
RUN corepack enable && corepack prepare pnpm@11.2.2 --activate

# Dependency layer (cached unless the lockfile/package.json changes).
COPY ${REACT_DIR}/package.json ${REACT_DIR}/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Source + build. Vite base is "/" (vite.config.ts) → output lands in dist/.
COPY ${REACT_DIR}/ ./
RUN pnpm exec vite build

# ---------------------------------------------------------------------------
# Stage 2 — restore + publish the .NET host.
# The React dist is dropped at the exact path the Client csproj's
# CopyNodeReactBuildToWwwroot target watches (Client.React/dist/), so the target
# fires during Build/Publish and copies the SPA into wwwroot + publish output.
# ---------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS publish
ARG APP_DIR
ARG REACT_DIR
WORKDIR /src

# Parent-repo central build configuration (CPM). These must sit at /src so the
# MSBuild Directory.* walk resolves to them for any project that is not covered
# by the app tree's own Directory.* files.
COPY Directory.Build.props Directory.Packages.props ./

# The app tree (its own Directory.Build.props/Directory.Packages.props win for
# projects under it via the nearest-ancestor rule). This now also carries
# XE-Local-AI-Engine.AI.Contracts, which lives inside the app tree.
COPY ${APP_DIR}/ ./${APP_DIR}/

# Drop the freshly built SPA where CopyNodeReactBuildToWwwroot expects it.
COPY --from=react /react/dist/ ./${APP_DIR}/XE-Local-AI-Engine.Client.React/dist/

# Framework-dependent publish (runtime base supplies the shared framework).
# linux-x64 is implicit from the SDK image RID.
RUN dotnet publish "${APP_DIR}/XE-Local-AI-Engine.Client/XE-Local-AI-Engine.Client.csproj" \
        -c Release \
        -o /app/publish \
        --no-self-contained \
    && test -f /app/publish/wwwroot/index.html \
    && echo "wwwroot/index.html present in publish output"

# ---------------------------------------------------------------------------
# Stage 3 — runtime.
# aspnet:10.0 ships a non-root `app` user and defaults ASPNETCORE_HTTP_PORTS to
# 8080 (the non-root-friendly default since .NET 8). We pin it explicitly and
# bind to all interfaces so the container is reachable from the host/network.
# ---------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Production environment; HTTP on 8080 (the manifest/runbook port for this image).
ENV ASPNETCORE_ENVIRONMENT=Production \
    ASPNETCORE_HTTP_PORTS=8080 \
    ASPNETCORE_URLS=http://+:8080 \
    DOTNET_RUNNING_IN_CONTAINER=true

# WORKDIR creates /app as root:root. Give the app user ownership of the directory
# itself so it can create runtime-write subdirs (dead-letter-queue/, cert-pin-store/).
# This chowns only the empty dir inode — no file data is duplicated.
RUN chown app:app /app

# --chown sets file ownership at copy time in a single layer (no RUN chown -R duplication).
# /app must remain fully app-writable for RC1: the following paths are created at
# ContentRootPath root at first run and cannot be relocated without code changes:
#   dead-letter-queue/   (FileDeadLetterStore — WorkDir-relative)
#   node-settings.json   (NodeSettingsStore    — ContentRootPath)
#   credentials.json     (CloudCredentialStore — ContentRootPath)
#   token-store.json     (TokenStore           — ContentRootPath)
#   cert-pin-store/      (CertPinStore         — ContentRootPath)
# The sqlite DB lives outside the image (ConnectionStrings:node-sqlite env var).
# DataProtection keys land in ~/.aspnet/DataProtection-Keys (HOME=/home/app).
# GA follow-up: move runtime-write paths to a dedicated data/ dir + make code
# root read-only; then --chown can be scoped to data/ only.
COPY --from=publish --chown=app:app /app/publish ./

# Run as the pre-provisioned non-root user shipped in the aspnet base image.
USER app

EXPOSE 8080

ENTRYPOINT ["dotnet", "XE-Local-AI-Engine.Client.dll"]
