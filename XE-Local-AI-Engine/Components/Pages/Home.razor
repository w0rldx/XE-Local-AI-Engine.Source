@page "/"
@using XE_Local_AI_Engine.Components.Shared
@using XE_Local_AI_Engine.Services.Auth
@using XE_Local_AI_Engine.Services.Connection
@implements IDisposable
@rendermode @(new InteractiveServerRenderMode(false))
@inject IWorkerHubConnection WorkerHubConnection
@inject ConnectionState ConnectionState
@inject ITokenStore TokenStore

<PageTitle>Worker Node Home</PageTitle>

<section class="dashboard-page">
    <header class="dashboard-page__header">
        <div>
            <p class="dashboard-page__eyebrow">Worker Node</p>
            <h1>Welcome to the worker console</h1>
            <p class="dashboard-page__description">Use the worker dashboard to pair this node, inspect capabilities, and monitor live invocations from the Central Platform.</p>
        </div>

        <ConnectionStatusBadge />
    </header>

    <div class="dashboard-grid">
        <section class="dashboard-card">
            <div class="dashboard-card__header">
                <h2>Current status</h2>
                <p>Quick summary of pairing and connection health.</p>
            </div>

            <dl class="dashboard-metadata">
                <div>
                    <dt>Pairing</dt>
                    <dd>@(TokenStore.IsPaired ? "Paired" : "Not paired")</dd>
                </div>
                <div>
                    <dt>Connection</dt>
                    <dd>@GetConnectionLabel()</dd>
                </div>
                <div>
                    <dt>Token expiry</dt>
                    <dd>@GetTokenExpiryLabel()</dd>
                </div>
                <div>
                    <dt>Last update</dt>
                    <dd>@ConnectionState.LastUpdatedAt.ToLocalTime().ToString("g")</dd>
                </div>
            </dl>

            @if (!string.IsNullOrWhiteSpace(ConnectionState.LastError))
            {
                <p class="dashboard-inline-error">Last error: @ConnectionState.LastError</p>
            }
        </section>

        <section class="dashboard-card">
            <div class="dashboard-card__header">
                <h2>Where to go next</h2>
                <p>Open the area that matches the task you want to perform.</p>
            </div>

            <div class="route-not-found__actions">
                <a class="route-not-found__link" href="/dashboard">Open dashboard</a>
                <a class="route-not-found__link route-not-found__link--secondary" href="/pairing">Open pairing wizard</a>
                <a class="route-not-found__link route-not-found__link--secondary" href="/invocations">Open invocation monitor</a>
            </div>
        </section>
    </div>
</section>

@code {
    protected override void OnInitialized()
    {
        WorkerHubConnection.StateChanged += OnStateChanged;
        TokenStore.TokensChanged += OnTokensChanged;
    }

    public void Dispose()
    {
        WorkerHubConnection.StateChanged -= OnStateChanged;
        TokenStore.TokensChanged -= OnTokensChanged;
    }

    private void OnStateChanged(object? sender, WorkerConnectionStateChangedEventArgs eventArgs)
    {
        _ = sender;
        _ = eventArgs;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnTokensChanged(object? sender, EventArgs eventArgs)
    {
        _ = sender;
        _ = eventArgs;
        _ = InvokeAsync(StateHasChanged);
    }

    private string GetConnectionLabel()
    {
        return WorkerHubConnection.State switch
        {
            WorkerConnectionState.Connected => "Connected",
            WorkerConnectionState.Connecting => "Connecting",
            WorkerConnectionState.Reconnecting => "Reconnecting",
            WorkerConnectionState.Pairing => "Pairing",
            WorkerConnectionState.Error => "Error",
            _ => "Offline",
        };
    }

    private string GetTokenExpiryLabel()
    {
        if (!TokenStore.IsPaired)
        {
            return "No token stored";
        }

        if (TokenStore.TokenExpiresAt is not { } expiresAt)
        {
            return "Unknown";
        }

        var localExpiry = expiresAt.ToLocalTime().ToString("g");
        if (TokenStore.IsTokenExpired)
        {
            return $"Expired ({localExpiry})";
        }

        if (TokenStore.IsTokenExpiringSoon)
        {
            return $"Expiring soon ({localExpiry})";
        }

        return localExpiry;
    }
}
